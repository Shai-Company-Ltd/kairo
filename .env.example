# Copier en .env (même dossier que engine.py) puis : chmod 600 .env
# ---------- Marché
SYMBOL=BTCUSDT
LEVERAGE=20
TIMEFRAMES=1m,5m,15m,1h,4h,1d
TRADE_TIMEFRAMES=5m,15m,1h,4h,1d   # v4.1 : 1m retiré du trading (reste en contexte via TIMEFRAMES)

# ---------- Mode (PAPER par défaut). Ordres réels SEULEMENT si LIVE=1 ET DRY_RUN=0
DRY_RUN=1                  # paper par défaut
LIVE=0                     # 1 = ordres réels (avec DRY_RUN=0)
START_EQUITY=25
AUTO_TRADE=1
MIN_CONF_TRADE=0.44
MIN_CONF_ALERT=0.70

# ---------- Clés Bitunix (uniquement pour le live ; permissions : trading, PAS de retrait ; IP whitelist = IP_DE_VOTRE_VPS)
BITUNIX_API_KEY=your_bitunix_api_key
BITUNIX_API_SECRET=your_bitunix_api_secret

# ---------- Risque (x20 isolé)
RISK_PCT=12           # v4.2 : % max de l'equity risqué par trade (plafonné par MAX_MARGIN_PCT)
MAX_MARGIN_PCT=25
MAX_OPEN=6
DAILY_STOP_PCT=100   # désactivé (pas de stop journalier)
KILL_EQUITY=12        # equity <= 12 USDT -> tout fermer + HALT
TARGET_EQUITY=100
MAX_CONSEC_LOSSES=9999   # désactivé
PAUSE_AFTER_LOSSES_MIN=120
RR=1.5               # v4.2 : TP à 1.5R
ATR_SL_MULT=1.5
MIN_SL_PCT=0.41
FEE_RATE=0.0006
MAX_FEE_SHARE=0.20   # v4.2 : frais estimés maker entrée + taker sortie

# ---------- Webhook Grok Bot (routine de "bot trading")
WEBHOOK_URL=https://example.com/webhook/your-routine-id
WEBHOOK_KEY=your_webhook_key
# Format : "NomDuHeader: Préfixe"  ->  Authorization: Bearer <clé>
# ou juste "NomDuHeader"            ->  NomDuHeader: <clé>
WEBHOOK_KEY_HEADER=Authorization: Bearer
MAX_ALERTS_DAY=10
MAX_EVENTS_DAY=12
ALERT_MIN_GAP_MIN=30
ALERT_COOLDOWN_MIN=120
FUNDING_ALERT_PCT=0.05
DIGEST_HOURS_UTC=6   # v4.1 : 1 digest/jour, 06 UTC = 14:00 UTC+8
STARTUP_ALERT=0

# ---------- API de contrôle (optionnelle : /status /pause /resume /close_all)
CONTROL_PORT=0
CONTROL_BIND=127.0.0.1
CONTROL_TOKEN=change_me

# ---------- Divers
POLL_SEC=15
LOG_LEVEL=INFO
# DB_PATH=/opt/trading-v4/server/journal.db

# ---------- v4.1 (mettre 0 pour désactiver chaque nouveauté)
WEBHOOK_BATCH=1            # trade_open/close/setup/target en tampon -> 1 récap groupé
BATCH_HOURS=3
BATCH_SEND_EMPTY=0         # 1 = envoyer le récap même vide
URGENT_COALESCE=1          # urgences de la même minute -> 1 seul envoi (kill_switch toujours immédiat)
URGENT_DD_PCT=15           # alerte urgente si drawdown du jour > 15 % (0 = off)
URGENT_ERR_COOLDOWN_MIN=30
DIGEST_TEXT=1              # digest en texte formaté en code
ADX_FILTER=1               # breakout/pullback seulement si ADX > ADX_MIN
ADX_PERIOD=14
ADX_MIN=20
ENTRY_POST_ONLY=1          # entrée limite au meilleur prix (0 = marché comme v4)
POST_ONLY_SUPPORTED=1      # testé le 22/10 : post-only croisant annulé sans remplissage (0 = limite GTC)
ENTRY_TIMEOUT_SEC=20       # non rempli -> annulé, jamais chassé
TP_LIMIT=1                 # TP en limite ; SL toujours au marché

# ---------- v4.2 (mettre 0 / off pour désactiver chaque nouveauté)
MAKER_FEE_RATE=0.0002
FEE_MODEL_MAKER=1
PARTIAL_TP=1               # 50 % fermés à 1R
PARTIAL_R=1.0
PARTIAL_FRAC=0.5
PARTIAL_LIMIT=1            # partielle en ordre limite posé à l'ouverture (repli marché)
BE_AFTER_PARTIAL=1         # SL -> break-even + frais après la partielle
BE_FEE_PCT=0.10
MAX_PER_TF=2
BREAKOUT5M_STRICT=1        # vol >= 2x moy20 + clôture au-delà
BREAKOUT5M_VOL_MULT=2.0
ATR_FILTER=1
ATR_MIN_PCT=5m:0.090,15m:0.165,1h:0.37,4h:0.90,1d:2.6
VWAP_OBV=boost             # off | filter | boost
VWAP_OBV_BONUS=0.03
OBV_SLOPE_BARS=10
KRONOS_FILTER=1            # actif seulement si précision 1h >= KRONOS_MIN_ACC sur >= KRONOS_MIN_N
KRONOS_DB=/opt/kronos/predictions.db
KRONOS_MIN_ACC=0.55
KRONOS_MIN_N=50
AUTO_KILL=1
AUTO_KILL_DAYS=3
AUTO_KILL_MIN_N=8
AUTO_KILL_MAX_WR=0.40
